@model AccountPasswordViewModel

@{
    ViewData["Title"] = "Update Password";
}

<link href="~/css/user-create-from-style.css" rel="stylesheet" />

<div class="create-form-wrapper">
    <div class="d-flex align-items-start justify-content-between mb-3">
        <div>
            <h4 class="mb-0">Update Password</h4>
            <p class="text-muted mb-0" style="font-size:0.85rem;">Set a new password for the selected user.</p>
        </div>
        <a asp-action="Index" class="btn btn-primary btn-sm">&#8592; Back to List</a>
    </div>

    <form asp-action="UpdatePassword" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-section">
            <div class="form-section-header"><span>Account</span></div>
            <div class="form-section-body">
                <div class="mb-3">
                    <div class="form-label small fw-semibold">Username</div>
                    <div class="form-control-plaintext">@Model.Username</div>
                </div>
                <div class="field-row field-row-2 mb-3">
                    <div>
                        <label asp-for="Password" class="form-label small fw-semibold"></label>
                        <input asp-for="Password" type="password" class="form-control form-control-sm" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control form-control-sm" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-1">
            <input type="submit" value="Update Password" class="btn btn-secondary btn-sm px-4" />
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
