@model AccountEditViewModel

@{
    ViewData["Title"] = "Edit User";
}

<link href="~/css/user-create-from-style.css" rel="stylesheet" />

<div class="create-form-wrapper">
    <div class="d-flex align-items-start justify-content-between mb-3">
        <div>
            <h4 class="mb-0">Edit User</h4>
            <p class="text-muted mb-0" style="font-size:0.85rem;">Update the employee's information below.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="UpdatePassword" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">Update Password</a>
            <a asp-action="Index" class="btn btn-primary btn-sm">&#8592; Back to List</a>
        </div>
    </div>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-section">
            <div class="form-section-header"><span>Employee Information</span></div>
            <div class="form-section-body">
                <div class="field-row field-row-3 mb-3">
                    <div>
                        <label asp-for="EmployeeNumber" class="form-label small fw-semibold"></label>
                        <input asp-for="EmployeeNumber" type="text" inputmode="numeric" maxlength="4" class="form-control form-control-sm" />
                        <span asp-validation-for="EmployeeNumber" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="FirstName" class="form-label small fw-semibold"></label>
                        <input asp-for="FirstName" class="form-control form-control-sm" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="LastName" class="form-label small fw-semibold"></label>
                        <input asp-for="LastName" class="form-control form-control-sm" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>
                <div class="field-row field-row-2 mb-3">
                    <div>
                        <label asp-for="Department" class="form-label small fw-semibold"></label>
                        <select asp-for="Department" asp-items="Model.Departments" class="form-select form-select-sm js-select2">
                            <option value="" disabled>-- Select department --</option>
                        </select>
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="Role" class="form-label small fw-semibold"></label>
                        <select asp-for="Role" class="form-select form-select-sm js-select2">
                            <option value="" disabled>-- Select user role --</option>
                            @foreach (var role in Enum.GetValues<Roles>())
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-header"><span>Access Permissions</span></div>
            <div class="form-section-body">
                <div class="check-subsection-label">Departments</div>
                <div class="check-grid">
                    @foreach (var department in Model.Departments)
                    {
                        <label class="check-pill">
                            <input type="checkbox" name="AccessDepartments" value="@department.Value" @(Model.AccessDepartments.Contains(department.Value, StringComparer.Ordinal) ? "checked" : "") />
                            @department.Text
                        </label>
                    }
                </div>
                <div class="check-subsection-label">Companies</div>
                <div class="check-grid">
                    @foreach (var company in Model.Companies)
                    {
                        <label class="check-pill">
                            <input type="checkbox" name="AccessCompanies" value="@company.Value" @(Model.AccessCompanies.Contains(company.Value, StringComparer.Ordinal) ? "checked" : "") />
                            @company.Text
                        </label>
                    }
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-header"><span>Account Status</span></div>
            <div class="form-section-body">
                <div class="mb-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small fw-semibold text-dark">Active</div>
                        <div class="text-muted" style="font-size:0.78rem;">Allow this user to log in and access the system.</div>
                    </div>
                    <div class="form-check form-switch mb-0 ms-3">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" style="width:2.5em; height:1.3em; cursor:pointer;" />
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-1">
            <input type="submit" value="Update" class="btn btn-secondary btn-sm px-4" />
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
