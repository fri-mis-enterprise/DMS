@model Document_Management.Models.HomeDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<section class="dashboard-shell">
    <div class="dashboard-hero">
        <div>
            <p class="dashboard-eyebrow">Document Management System</p>
            <h1>Welcome back, @Model.Username</h1>
            <p class="dashboard-subtitle">Here is an overview of the documents available to you.</p>
        </div>
        <div class="dashboard-actions">
            <a class="btn dashboard-btn dashboard-btn-primary" asp-controller="Dms" asp-action="UploadFile">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Upload File
            </a>
            <a class="btn dashboard-btn dashboard-btn-secondary" asp-controller="Dms" asp-action="DownloadFile">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 4v12m0 0 4.5-4.5M12 16l-4.5-4.5M5 20h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Download File
            </a>
        </div>
    </div>

    <div class="dashboard-stats" aria-label="Document statistics">
        <article class="stat-card stat-card-blue">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M7 3h7l4 4v14H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                    <path d="M14 3v5h4M9 13h6M9 17h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
            </div>
            <div>
                <p class="stat-label">Active documents</p>
                <p class="stat-value">@Model.ActiveDocuments.ToString("N0")</p>
            </div>
        </article>

        <article class="stat-card stat-card-green">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.8" />
                    <path d="M7 3v4M17 3v4M3 10h18M8 15h3M13 15h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
            </div>
            <div>
                <p class="stat-label">Uploaded this month</p>
                <p class="stat-value">@Model.UploadedThisMonth.ToString("N0")</p>
            </div>
        </article>

        <article class="stat-card stat-card-purple">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                    <path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20" stroke="currentColor" stroke-width="1.8" />
                </svg>
            </div>
            <div>
                <p class="stat-label">Pages stored</p>
                <p class="stat-value">@Model.TotalPages.ToString("N0")</p>
            </div>
        </article>

        <article class="stat-card stat-card-orange">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <ellipse cx="12" cy="5" rx="8" ry="3" stroke="currentColor" stroke-width="1.8" />
                    <path d="M4 5v7c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12v7c0 1.7 3.6 3 8 3s8-1.3 8-3v-7" stroke="currentColor" stroke-width="1.8" />
                </svg>
            </div>
            <div>
                <p class="stat-label">Storage used</p>
                <p class="stat-value">@Model.FormattedStorageUsed</p>
            </div>
        </article>
    </div>

    <article class="tutorial-card">
        <div class="tutorial-heading">
            <div>
                <p class="dashboard-eyebrow">Getting started</p>
                <h2>How to use DMS</h2>
            </div>
            <p>Watch this quick walkthrough to learn how to upload, search, and manage your documents.</p>
        </div>
        <div class="ratio ratio-16x9 tutorial-video">
            <iframe src="https://player.vimeo.com/video/1104402765?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479"
                    allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    title="Watch: How to Use the DMS Effectively">
            </iframe>
        </div>
    </article>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/home-dashboard.css" asp-append-version="true" />
}

@section Scripts {
    <script src="https://player.vimeo.com/api/player.js"></script>
}
