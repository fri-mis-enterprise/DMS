@inject IHttpContextAccessor HttpContextAccessor
@{
    var userRole = Context.Session.GetString("userRole")?.ToLower();

    var assembly = typeof(Program).Assembly;
    var informationalVersion = System.Reflection.CustomAttributeExtensions
        .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(assembly)?
        .InformationalVersion;
    var appVersion = informationalVersion?.Split('+')[0]
        ?? assembly.GetName().Version?.ToString()
        ?? "0.0.0";
    var currentYear = DateTime.UtcNow.Year;
    var copyrightYears = currentYear > 2024
        ? $"2024-{currentYear}"
        : "2024";

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DMS ▪ @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/svg/dms-icon.svg" rel="shortcut icon" type="image/svg" />
    <link rel="stylesheet" href="~/css/site.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DocumentManagement.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="globalLoadingOverlay" class="submit-loading-overlay d-none">
        <div class="submit-loading-card" role="status" aria-live="polite" aria-label="Loading">
            <div class="spinner-border text-primary mb-3" aria-hidden="true"></div>
            <div id="globalLoadingMessage" class="mt-3">Loading...</div>
        </div>
    </div>
    <header>
        <nav class="navbar navbar-expand-lg" data-bs-theme="dark" style="background-color:#00008B;">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/svg/dms-logo.svg" class="ms-4" alt="DMS" width="45" height="45"/>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarColor01">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                Home
                                <span class="visually-hidden">(current)</span>
                            </a>
                        </li>
                        @if (userRole == "admin")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Master</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Index">Users</a>
                                    <a class="dropdown-item" asp-controller="Company" asp-action="Index">Companies</a>
                                    <a class="dropdown-item" asp-controller="Department" asp-action="Index">Departments</a>
                                    <a class="dropdown-item" asp-controller="Category" asp-action="Index">Categories</a>
                                    <a class="dropdown-item" asp-controller="SubCategory" asp-action="Index">Sub Categories</a>
                                </div>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(userRole))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Document Management</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-controller="Dms" asp-action="UploadFile">Upload File</a>
                                    <a class="dropdown-item" asp-controller="Dms" asp-action="DownloadFile">Download File</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" asp-controller="Dms" asp-action="Index">Uploaded Files</a>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Dms" asp-action="Trash">Trash</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Report" asp-action="ActivityReportForm">Activity Report</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Dms" asp-action="GeneralSearch">Search</a>
                            </li>
                        }

                        @if (userRole == "admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Logs" asp-action="Index">Logs</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="py-3">
            <input type="hidden" id="hfUsername" value="@HttpContextAccessor.HttpContext?.Session.GetString("username")" />
            <partial name="_Notification" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @copyrightYears - DMS @($"v{appVersion}") - <a asp-controller="Home" asp-action="Index">Home</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- Add this link in your HTML to include SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
    <script>
        (function () {
            const overlay = document.getElementById('globalLoadingOverlay');
            const messageElement = document.getElementById('globalLoadingMessage');

            window.showGlobalLoading = function (message) {
                if (!overlay || !messageElement) {
                    return;
                }

                messageElement.textContent = message || 'Loading...';
                overlay.classList.remove('d-none');
            };

        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
